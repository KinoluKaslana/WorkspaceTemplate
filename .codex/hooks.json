{
  "description": "WorkspaceTemplate 工作区治理守门（先读 AGENT_RULES.md 再写）",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" session_start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" prompt_submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" pre_bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" pre_write",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" post_bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" post_write",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" session_end",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" subagent_start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_CLIENT=codex /usr/bin/python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.workspace/hooks/hook.py\" subagent_stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
